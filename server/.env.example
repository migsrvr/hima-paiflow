# Copy to .env and provide your own values. Never commit .env. Never put any of these in EXPO_PUBLIC_*.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_MS=60000
PORT=3001
HOST=127.0.0.1
# Comma-separated browser origins (the Expo web preview); native apps don't need this.
# CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Signs session tokens issued at sign-in (at least 32 characters). npm run stellar:setup creates one.
SESSION_SECRET=

# Testnet wallets. npm run stellar:setup creates and funds any that are missing.
STELLAR_STUDENT_SECRET=          # pays checkout; receives the allowance Spending share
STELLAR_SPONSOR_SECRET=          # funds the allowance flow and the reward pool
STELLAR_MERCHANT_PUBLIC_KEY=     # Campus Canteen (Flow 1, 90%)
STELLAR_SAVINGS_PUBLIC_KEY=      # Flow 1 10%, Flow 2 savings share, Flow 3 reward
STELLAR_EMERGENCY_PUBLIC_KEY=    # Flow 2 emergency share
# HORIZON_URL=https://horizon-testnet.stellar.org

# Paiflow: one deployment per flow, each with its own API token (API access panel; shown once).
PAIFLOW_BASE_URL=https://beta.app.paiflow.xyz
# Flow 1, NFC checkout: Receive (XLM) → Split 90% canteen / 10% savings
PAIFLOW_CHECKOUT_ID=
PAIFLOW_CHECKOUT_TOKEN=
PAIFLOW_CHECKOUT_TRIGGER_CONTRACT=
# Flow 2, Smart allowance: Receive (XLM) → Condition amount > 10 XLM → Split 70/20/10 or 85/10/5
PAIFLOW_ALLOWANCE_ID=
PAIFLOW_ALLOWANCE_TOKEN=
PAIFLOW_ALLOWANCE_TRIGGER_CONTRACT=
# Flow 3, AI savings reward: Webhook (HTTP callbacks on) → Pay → savings
PAIFLOW_REWARD_ID=
PAIFLOW_REWARD_TOKEN=
PAIFLOW_REWARD_WEBHOOK_SECRET=
# PAIFLOW_TIMEOUT_MS=20000
# The addresses each deployment actually pays, when they differ from the wallets above. Payouts are
# verified on Horizon against these. Format: role:G… pairs.
# PAIFLOW_CHECKOUT_RECIPIENTS=merchant:G…,savings:G…
# PAIFLOW_ALLOWANCE_RECIPIENTS=spending:G…,savings:G…,emergency:G…
# PAIFLOW_REWARD_RECIPIENT=G…

# Fixed demo rate: PHP per XLM (1 XLM = ₱7.50). Largest single checkout, in whole pesos.
PHP_PER_INPUT_UNIT=7.50
PAYMENT_MAX_PHP=5000
# Flow 2: allow POST /api/allowance/fund from the app (dev only).
ALLOWANCE_DEV_FUNDING=false
# Flow 3: reward per verified week; REWARD_ALLOW_OPEN_PERIOD=true lets demos claim the current week.
REWARD_AMOUNT_XLM=5
REWARD_ALLOW_OPEN_PERIOD=false
REWARD_TZ_OFFSET_MINUTES=480
# DATA_DIR=data
