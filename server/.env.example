# Copy to .env and provide your own values. Never commit .env.
KIMI_API_KEY=
KIMI_MODEL=kimi-for-coding
KIMI_TIMEOUT_MS=60000
PORT=3001
HOST=127.0.0.1
# Comma-separated browser origins; unset allows non-browser/native clients only.
# CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Stellar testnet. npm run stellar:setup creates and funds these if they are missing.
STELLAR_STUDENT_SECRET=
STELLAR_MERCHANT_PUBLIC_KEY=
# HORIZON_URL=https://horizon-testnet.stellar.org

# Paiflow deployment (API access panel). The token is shown once when created; keep it here only.
# PAIFLOW_API_BASE=https://beta.app.paiflow.xyz/api/v1
PAIFLOW_DEPLOYMENT_ID=
PAIFLOW_TRIGGER_CONTRACT=
PAIFLOW_API_TOKEN=
# PAIFLOW_TIMEOUT_MS=20000

# Fixed demo rate: PHP per unit of the flow's input asset (1 XLM = ₱7.50).
PHP_PER_INPUT_UNIT=7.50
# Largest single payment, in whole pesos.
PAYMENT_MAX_PHP=5000
# PAYMENTS_FILE=data/payments.json

# Persistent hosting (server-only credentials; never EXPO_PUBLIC_*).
# Local development defaults to file. Render requires postgres; no outage fallback.
STORAGE_BACKEND=file
# Neon Connect -> turn Connection pooling OFF and copy the direct PostgreSQL URL.
# Its hostname must not contain the -pooler suffix. Keep SSL enabled.
DATABASE_URL=
# Optional PEM CA for a trusted private/self-signed database; TLS verification stays enabled.
DATABASE_SSL_CA=

# Public demo. Limits: 0 turns one off; payments count per day, sign-in and AI per hour.
# Behind a proxy (Render sets RENDER=true, which trusts one hop) limits count the client's IP.
# TRUST_PROXY=
RATE_SIGNIN_PER_IP_HOUR=10
RATE_AI_PER_USER_HOUR=20
RATE_AI_PER_IP_HOUR=40
RATE_PAYMENTS_PER_USER_DAY=5
RATE_PAYMENTS_PER_IP_DAY=10
RATE_PAYMENTS_PER_DAY=100
# Refill the testnet paying wallet with Friendbot XLM when it drops below this (0 = off). npm run wallet:topup does it by hand.
DEMO_TOPUP_BELOW_XLM=100
